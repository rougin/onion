{
  "name": "rougin/onion",
  "description": "HTTP middlewares for Slytherin.",
  "homepage": "https://github.com/rougin/onion",
  "license": "MIT",
  "authors":
  [
    {
      "email": "rougingutib@gmail.com",
      "name": "Rougin Gutib"
    }
  ],
  "require":
  {
    "php": ">=5.3.0"
  },
  "require-dev":
  {
    "phpunit/phpunit": "*",
    "sanmai/phpunit-legacy-adapter": "*"
  },
  "autoload":
  {
    "psr-4":
    {
      "Rougin\\Onion\\": "src"
    }
  },
  "autoload-dev":
  {
    "psr-4":
    {
      "Rougin\\Onion\\": "tests"
    }
  },
  "scripts":
  {
    "analyze": "phpstan analyse",
    "restyle": "php-cs-fixer fix --config=phpstyle.php",
    "test": "phpunit"
  }
}
